set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C5T144C8
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 144

# The CoreEP2C5 uses configuration-capable pins as normal FX2 FIFO I/O after
# configuration.  Reserve them explicitly so Quartus does not keep nCEO and
# other configuration functions on top of the assigned FIFO pins.
set_global_assignment -name USE_CONFIGURATION_DEVICE ON
set_global_assignment -name RESERVE_ASDO_AFTER_CONFIGURATION "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_DATA7_THROUGH_DATA2_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_FLASH_NCE_AFTER_CONFIGURATION "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_OTHER_AP_PINS_AFTER_CONFIGURATION "AS INPUT TRI-STATED"
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_DATA0_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_DATA1_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name RESERVE_DCLK_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name TOP_LEVEL_ENTITY ml_fx2_stream_bridge
set_global_assignment -name SYSTEMVERILOG_FILE ml_fx2_stream_bridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../ml_inference.sv
set_global_assignment -name SDC_FILE fx2_ml_bridge.sdc
set_global_assignment -name MIF_FILE ../../artifacts/weights_l1.mif
set_global_assignment -name MIF_FILE ../../artifacts/weights_l2.mif
set_global_assignment -name MIF_FILE ../../artifacts/bias_l1.mif
set_global_assignment -name MIF_FILE ../../artifacts/bias_l2.mif
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_location_assignment PIN_75 -to FIFOADR[0]
set_location_assignment PIN_76 -to FIFOADR[1]
set_location_assignment PIN_97 -to FIFODATA[7]
set_location_assignment PIN_96 -to FIFODATA[6]
set_location_assignment PIN_94 -to FIFODATA[5]
set_location_assignment PIN_93 -to FIFODATA[4]
set_location_assignment PIN_92 -to FIFODATA[3]
set_location_assignment PIN_87 -to FIFODATA[2]
set_location_assignment PIN_86 -to FIFODATA[1]
set_location_assignment PIN_81 -to FIFODATA[0]
set_location_assignment PIN_99 -to FIFODATA[8]
set_location_assignment PIN_100 -to FIFODATA[9]
set_location_assignment PIN_101 -to FIFODATA[10]
set_location_assignment PIN_103 -to FIFODATA[11]
set_location_assignment PIN_104 -to FIFODATA[12]
set_location_assignment PIN_112 -to FIFODATA[13]
set_location_assignment PIN_113 -to FIFODATA[14]
set_location_assignment PIN_114 -to FIFODATA[15]
set_location_assignment PIN_17 -to clk
set_location_assignment PIN_88 -to rst
set_location_assignment PIN_73 -to SLWR
set_location_assignment PIN_71 -to FLAGA
set_location_assignment PIN_79 -to FLAGB
set_location_assignment PIN_80 -to FLAGC
set_location_assignment PIN_72 -to SLOE
set_location_assignment PIN_74 -to SLRD
set_location_assignment PIN_8 -to led[0]
set_location_assignment PIN_9 -to led[1]
set_location_assignment PIN_24 -to led[2]
set_location_assignment PIN_25 -to led[3]
set_location_assignment PIN_4 -to buzz
